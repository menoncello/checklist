[
  {
    "name": "should have all required fields",
    "description": "Template should have version, metadata, variables, dependencies, and steps",
    "inputs": {
      "appName": "MyFullstackApp",
      "frontendFramework": "react",
      "backendFramework": "express",
      "database": "postgres",
      "author": "Development Team",
      "includeDocker": "true",
