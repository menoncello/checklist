      {
        "type": "exists",
        "path": "variables",
        "value": true
      },
      {
        "type": "exists",
        "path": "dependencies",
        "value": true
      },
      {
        "type": "exists",
        "path": "steps",
        "value": true
      }
    ]
  },
  {
    "name": "should have correct metadata with fullstack tag",
    "description": "Metadata should identify this as a fullstack template",
    "inputs": {
      "appName": "TestApp",
      "author": "Test Team"
    },
    "assertions": [
      {
        "type": "equals",
        "path": "metadata.id",
        "value": "fullstack-app"
      },
      {
        "type": "contains",
        "path": "metadata.tags",
        "value": "fullstack"
      },
      {
        "type": "contains",
        "path": "metadata.tags",
        "value": "web"
      },
      {
        "type": "contains",
        "path": "metadata.tags",
        "value": "api"
      }
    ]
  },
